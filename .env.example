# SDL / XDR tenant configuration
# Copy this file to .env and fill in real values.
# NEVER point SDL_BASE_URL at a production tenant.

SDL_BASE_URL=https://xdr.us1-poc.sentinelone.net
SDL_READ_TOKEN=your_read_token_here
SDL_WRITE_TOKEN=your_write_token_here
SDL_ACCOUNT_ID=your_account_id_here

# Seconds to wait after ingestion before querying for alerts (default: 30)
VERIFY_DELAY=30

# Set to "true" to print events without actually ingesting them
DRY_RUN=false
S1_API_TOKEN=
